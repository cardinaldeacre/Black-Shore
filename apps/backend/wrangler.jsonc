{
    "$schema": "https://www.unpkg.com/wrangler/config-schema.json",
    "name": "black-shore-backend",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "observability": {
        "enabled": true
    },
    "vars": {
        "ENVIRONMENT": "development"
    }
    // KV namespace & secrets akan ditambahkan nanti
}